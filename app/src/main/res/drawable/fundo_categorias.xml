<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A0000000"/>
            <corners android:radius="5dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cor_categorias"/>
            <corners android:radius="5dp"/>
            <stroke android:width="2dp" android:color="#12000000"/>
        </shape>
    </item>

</layer-list>