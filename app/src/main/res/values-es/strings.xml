    <!-- Stadium Descriptions -->
    <string name="stadium_desc_metlife">Ubicado en Nueva Jersey, es uno de los estadios más grandes de la NFL y sede de la final de la Copa del Mundo 2026.</string>
    <string name="stadium_desc_att">Una maravilla tecnológica con una de las pantallas de video más grandes del mundo y techo retráctil.</string>
    <string name="stadium_desc_sofi">El estadio más caro y moderno del mundo, ubicado en la región de Los Ángeles.</string>
    <string name="stadium_desc_hard_rock">Icónico estadio multiusos que ha albergado seis Super Bowls.</string>
    <string name="stadium_desc_lumen_field">Conocido por su atmósfera vibrante y por ser el estadio más ruidoso de la MLS/NFL.</string>
    <string name="stadium_desc_levis">Un estadio sostenible y tecnológico en el corazón de Silicon Valley.</string>
    <string name="stadium_desc_lincoln_financial">Un estadio moderno que utiliza energía solar y eólica para su funcionamiento.</string>
    <string name="stadium_desc_gillette">Ubicado cerca de Boston, es el hogar histórico de los New England Patriots.</string>
    <string name="stadium_desc_nrg">Famoso por ser el primer estadio de la NFL en tener un techo retráctil.</string>
    <string name="stadium_desc_arrowhead">Registrado en el Guinness como el estadio abierto más ruidoso do planeta.</string>
    <string name="stadium_desc_mercedes_benz">Destaca por su arquitectura futurista y un techo que se abre como el lente de una cámara.</string>
    <string name="stadium_desc_azteca">El templo del fútbol mundial, primer estadio en albergar tres Copas del Mundo.</string>
    <string name="stadium_desc_akron">Uno de los estadios más bellos de México, conocido por su diseño en forma de volcán.</string>
    <string name="stadium_desc_bbva">Llamado el \"Gigante de Acero\", ofrece una vista espectacular de las montañas.</string>
    <string name="stadium_desc_bmo_field">El principal estadio de fútbol de Canadá, ubicado a orillas del lago Ontario.</string>
    <string name="stadium_desc_bc_place">Un increíble estadio multiusos con un sistema de techo retráctil sostenido por cables.</string>
