<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".MainActivity"
    android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/gradiente_banner_main"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_logo_id"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/img_logo">

            </ImageView>

            <LinearLayout
                android:id="@+id/display_nome"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_nome_do_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/nome_do_app"
                    android:textSize="20sp"
                    android:textStyle="bold">

                </TextView>

                <TextView
                    android:id="@+id/descricao_nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/descricao_nome"
                    android:textSize="16sp">

                </TextView>

            </LinearLayout>

        </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/img_estadio"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="25dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_tabelas"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/fundo_categorias"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tabelas_simbolo"
                    android:textSize="60dp"
                    android:gravity="center_vertical">

                </TextView>

                <TextView
                    android:id="@+id/txt_tabelas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tabelas"
                    android:textSize="22sp"
                    android:includeFontPadding="false"
                    android:textStyle="bold">

                </TextView>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:background="@drawable/fundo_categorias">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/teste"
                    android:textSize="22sp"
                    android:textStyle="bold">

                </TextView>

            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="25dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/fundo_categorias">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/teste"
                    android:textSize="22sp"
                    android:textStyle="bold">

                </TextView>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:background="@drawable/fundo_categorias">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/teste"
                    android:textSize="22sp"
                    android:textStyle="bold">

                </TextView>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="50dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="@color/cor_fundo_categorias"
            android:background="@drawable/forma_arredondada"
            android:orientation="horizontal">

            <ImageView
                android:layout_marginTop="3dp"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/img_logo">

            </ImageView>

            <ImageView
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/img_logo">

            </ImageView>

            <ImageView
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/img_logo">

            </ImageView>

            <ImageView
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/img_logo">

            </ImageView>

            <ImageView
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/img_logo"
                android:layout_marginEnd="10dp">

            </ImageView>

        </LinearLayout>



        <!--Fim fundo com foto-->
    </LinearLayout>

        </ScrollView>


    </LinearLayout>


</LinearLayout>