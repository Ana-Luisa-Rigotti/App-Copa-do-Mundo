            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textColor="@color/cor_textos_padrao"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtVitoriasTime2"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtEmpatesTime2"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtDerrotasTime2"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtGolsMarcadosTime2"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtGolsContraTime2"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtSaldoGolsTime2"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginEnd="2dp"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

    </LinearLayout>

    <!-- TIME 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/txtPosicaoTime3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terceiro_tabela"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtNomeTime3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="França"
            android:textColor="@color/cor_textos_padrao"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imgBandeiraTime3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/txtPontosTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtJogosTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtVitoriasTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtEmpatesTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtDerrotasTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp"  android:textColor="@color/cor_textos_padrao"/>
        <TextView android:id="@+id/txtGolsMarcadosTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtGolsContraTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp"  android:textColor="@color/cor_textos_padrao"/>
        <TextView android:id="@+id/txtSaldoGolsTime3" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:layout_marginEnd="2dp" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />

    </LinearLayout>

    <!-- TIME 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/txtPosicaoTime4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quarto_tabela"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtNomeTime4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Alemanha"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <ImageView
            android:id="@+id/imgBandeiraTime4"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/txtPontosTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtJogosTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtVitoriasTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtEmpatesTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtDerrotasTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp"  android:textColor="@color/cor_textos_padrao"/>
        <TextView android:id="@+id/txtGolsMarcadosTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtGolsContraTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />
        <TextView android:id="@+id/txtSaldoGolsTime4" android:layout_width="27dp" android:layout_height="wrap_content" android:gravity="center" android:layout_marginEnd="2dp" android:text="@string/zero" android:textSize="15sp" android:textColor="@color/cor_textos_padrao" />

    </LinearLayout>

</LinearLayout>