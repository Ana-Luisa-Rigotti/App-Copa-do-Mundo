<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:layout_marginEnd="6dp"
    android:layout_marginStart="6dp"
    android:background="@drawable/fundo_categorias"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="5dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtGrupo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_a"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cor_textos_padrao"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time"
                android:textSize="14sp"
                android:layout_marginTop="1dp"
                android:textColor="@color/cor_textos_padrao">

            </TextView>


        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="52dp">

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1">

            </View>

            <TextView
                android:layout_width="29dp"
                android:layout_height="wrap_content"
                android:text="@string/pontos"
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="@color/cor_textos_padrao"
                android:textStyle="bold">

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/partidas_jogadas"
                android:textColor="@color/cor_textos_padrao"
                android:textSize="13sp">

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/vitorias"
                android:textColor="@color/cor_textos_padrao"
                android:textSize="13sp">

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/empates"
                android:textColor="@color/cor_textos_padrao"
                android:textSize="13sp">

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/derrotas"
                android:maxLines="1"
                android:textColor="@color/cor_textos_padrao"
                android:textSize="13sp">

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/gols_marcados"
                android:textColor="@color/cor_textos_padrao"
                android:textSize="13sp">

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/gols_contra"
                android:textSize="13sp"
                android:textColor="@color/cor_textos_padrao"
                >

            </TextView>

            <TextView
                android:layout_width="27dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/saldo_de_gols"
                android:layout_marginEnd="3dp"
                android:textSize="13sp"
                android:textColor="@color/cor_textos_padrao"
              >

            </TextView>

        </LinearLayout>

    </LinearLayout>



    <!-- TIME 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/txtPosicaoTime1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/primeiro_tabela"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtNomeTime1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Brasil"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <ImageView
            android:id="@+id/imgBandeiraTime1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtPontosTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textColor="@color/cor_textos_padrao"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtJogosTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtVitoriasTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtEmpatesTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtDerrotasTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtGolsMarcadosTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtGolsContraTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

        <TextView
            android:id="@+id/txtSaldoGolsTime1"
            android:layout_width="27dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginEnd="2dp"
            android:text="@string/zero"
            android:textSize="15sp"
            android:textColor="@color/cor_textos_padrao"/>

    </LinearLayout>

    <!-- TIME 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp">

