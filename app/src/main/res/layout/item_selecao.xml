<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/card_selecao"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/fundo_categorias"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:id="@+id/txt_nome_selecao_item"
            android:text="@string/estados_unidos"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cor_textos_padrao">

        </TextView>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/teste"
            android:textSize="14sp"
            android:id="@+id/txt_contineente_selecao_item"
            android:textColor="@color/cor_textos_padrao"/>

    </LinearLayout>

</LinearLayout>