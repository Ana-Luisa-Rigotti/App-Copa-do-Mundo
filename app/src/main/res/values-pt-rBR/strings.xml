    <!-- Descrições -->
    <string name="stadium_desc_metlife">Localizado em New Jersey, é um dos maiores estádios da NFL e palco da final da Copa de 2026.</string>
    <string name="stadium_desc_att">Uma maravilha tecnológica com um dos maiores telões do mundo e teto retrátil.</string>
    <string name="stadium_desc_sofi">O estádio mais caro e moderno do mundo, localizado na região de Los Angeles.</string>
    <string name="stadium_desc_hard_rock">Estádio multiuso icônico que já sediou seis Super Bowls.</string>
    <string name="stadium_desc_lumen_field">Conhecido pela sua atmosfera vibrante e por ser o estádio mais barulhento da MLS/NFL.</string>
    <string name="stadium_desc_levis">Um estádio sustentável e tecnológico no coração do Vale do Silício.</string>
    <string name="stadium_desc_lincoln_financial">Um estádio moderno que utiliza energia solar e eólica para seu funcionamento.</string>
    <string name="stadium_desc_gillette">Localizado próximo a Boston, é a casa histórica do New England Patriots.</string>
    <string name="stadium_desc_nrg">Famoso por ser o primeiro estádio da NFL a possuir um teto retrátil.</string>
    <string name="stadium_desc_arrowhead">Registrado no Guinness como o estádio aberto mais barulhento do planeta.</string>
    <string name="stadium_desc_mercedes_benz">Destaque pela sua arquitetura futurista e teto que abre como uma lente de câmera.</string>
    <string name="stadium_desc_azteca">O templo do futebol mundial, primeiro estádio a sediar três Copas do Mundo.</string>
    <string name="stadium_desc_akron">Um dos estádios mais bonitos do México, conhecido por seu design em forma de vulcão.</string>
    <string name="stadium_desc_bbva">Chamado de \"Gigante de Aço\", oferece uma vista espetacular das montanhas.</string>
    <string name="stadium_desc_bmo_field">O principal estádio de futebol do Canadá, localizado na margem do Lago Ontário.</string>
    <string name="stadium_desc_bc_place">Um estádio multiuso incrível com um sistema de teto retrátil sustentado por cabos.</string>
