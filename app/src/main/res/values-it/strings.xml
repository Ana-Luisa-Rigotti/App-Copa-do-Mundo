    <!-- Descrizioni -->
    <string name="stadium_desc_metlife">Situato nel New Jersey, è uno dei più grandi stadi della NFL e sede della finale della Coppa del Mondo 2026.</string>
    <string name="stadium_desc_att">Una meraviglia tecnologica con uno dei più grandi schermi video del mondo e un tetto retrattile.</string>
    <string name="stadium_desc_sofi">Lo stadio più costoso e moderno del mondo, situato nella regione di Los Angeles.</string>
    <string name="stadium_desc_hard_rock">Iconico stadio multiuso che ha ospitato sei Super Bowl.</string>
    <string name="stadium_desc_lumen_field">Noto per la sua atmosfera vibrante e per essere lo stadio più rumoroso della MLS/NFL.</string>
    <string name="stadium_desc_levis">Uno stadio sostenibile e tecnologico nel cuore della Silicon Valley.</string>
    <string name="stadium_desc_lincoln_financial">Uno stadio moderno che utilizza l\'energia solare ed eolica per il suo funzionamento.</string>
    <string name="stadium_desc_gillette">Situato vicino a Boston, è la sede storica dei New England Patriots.</string>
    <string name="stadium_desc_nrg">Famoso per essere il primo stadio della NFL ad avere un tetto retrattile.</string>
    <string name="stadium_desc_arrowhead">Registrato nel Guinness come lo stadio aperto più rumoroso del pianeta.</string>
    <string name="stadium_desc_mercedes_benz">In risalto per la sua architettura futuristica e il tetto che si apre come l\'obiettivo di una macchina fotografica.</string>
    <string name="stadium_desc_azteca">Il tempio del calcio mondiale, il primo stadio a ospitare tre Coppe del Mondo.</string>
    <string name="stadium_desc_akron">Uno degli stadi più belli del Messico, noto per il suo design a forma di vulcano.</string>
    <string name="stadium_desc_bbva">Chiamato il \"Gigante d\'Acciaio\", offre una vista spettacolare sulle montagne.</string>
    <string name="stadium_desc_bmo_field">Il principale stadio di calcio del Canada, situato sulla riva del Lago Ontario.</string>
    <string name="stadium_desc_bc_place">Un incredibile stadio multiuso con un sistema de tetto retrattile supportato da cavi.</string>
